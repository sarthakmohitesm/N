h3 { color: #16213e; font-size: 14pt; margin-top: 20px; }
code { background-color: #f4f4f4; padding: 2px 6px; font-family: Consolas, monospace; font-size: 10pt; border: 1px solid #ddd; border-radius: 3px; }
pre { background-color: #1e1e1e; color: #d4d4d4; padding: 15px; font-family: Consolas, monospace; font-size: 10pt; border-radius: 5px; overflow-x: auto; }
table { border-collapse: collapse; width: 100%; margin: 15px 0; }
